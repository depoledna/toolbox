# Required for library functions that use OpenRouter (image generation/editing)
OPENROUTER_KEY=sk-or-v1-...

# Optional: Context7 API key for docs tool
CONTEXT7_API_KEY=

# Optional: App Store Connect API (for testflight/asc_api library functions)
ASC_API_KEY_ID=
ASC_ISSUER_ID=
ASC_API_KEY_PATH=

# Optional: Apple Search Ads (for apple_ads_keywords library function)
APPLE_ADS_CAMPAIGN_URL=
APPLE_ADS_APP_NAME=

# Optional: Chrome profile for browser automation persistence
CHROME_PROFILE_DIR=
CHROME_STATE_FILE=
